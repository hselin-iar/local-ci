# An example .local-ci/config for a Next.js application with Postgres and Drizzle migrations: two CI jobs mirrored step for step, a migrations check CI does not have,
# pull-request checks, the build repeated as x64, and four scanners. The database credentials belong to throwaway containers and protect nothing.
base main
image node:24-bookworm
user node
home /home/node
cache /home/node/.npm
keep node_modules
install npm ci
# Paste the real hash (local-ci init prints it): the run then fails whenever the workflow changes, until this config is brought into line.
# mirrors .github/workflows/ci.yml <sha256>

service postgres postgres:17
  env POSTGRES_USER=app
  env POSTGRES_PASSWORD=app
  env POSTGRES_DB=app
  health pg_isready -h 127.0.0.1 -U app -d app

job typecheck
  step typecheck: npm run typecheck
  step lint: npm run lint

job test
  uses postgres
  env DATABASE_URL=postgres://app:app@127.0.0.1:5432/app
  step migrate: npm run db:migrate
  step unit: npm test
    tests node
  step integration: npm run test:integration
    tests node
  step build: npm run build

# Its own job, so its own empty database: the base branch's schema first, then this commit's migrations on top (see recipes/drizzle-migrations.sh).
job migrations
  uses postgres
  env DATABASE_URL=postgres://app:app@127.0.0.1:5432/app
  step migrations: bash /local-ci/drizzle-migrations.sh
    expect ^migrations ok:.*

job pull-request
  step title: test -n "$PR_TITLE" && echo "title: $PR_TITLE"
    pr-only

x64 npm ci && npm run build

scan actionlint
scan osv package-lock.json
scan gitleaks
scan semgrep p/typescript p/react p/nextjs p/secrets
